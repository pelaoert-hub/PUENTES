  const DEVICE_ID = deviceId();
  const esc = t => { const d = document.createElement('div'); d.textContent = t || ''; return d.innerHTML; };

  let encuesta = null;
  const caja = document.getElementById('encuesta-caja');

  async function cargar(){
    try{
      const { data, error } = await db.from('encuestas')
        .select('*').eq('activa', true).order('created_at', {ascending:false}).limit(1);
      if(error || !data || !data.length){ caja.innerHTML = ''; return; }
      encuesta = data[0];
      await pintar();
    }catch(_){ caja.innerHTML = ''; }
  }

  async function pintar(){
    const { data: res } = await db.from('encuesta_resultados')
      .select('opcion, votos').eq('encuesta_id', encuesta.id);
    const conteo = {}; let total = 0;
    for(const r of (res || [])){ conteo[r.opcion] = r.votos; total += r.votos; }
    const mio = localStorage.getItem('voto_' + encuesta.id);

    const cuerpo = mio === null
      ? '<div class="enc-ops">' + encuesta.opciones.map((o,i) =>
          '<button type="button" class="enc-op" data-i="' + i + '">' + esc(o) + '</button>').join('') +
        '</div><p class="enc-pie">' + (total ? total + (total === 1 ? ' persona ya respondió' : ' personas ya respondieron') : 'Sé el primero en responder') + '</p>'
      : '<div class="enc-ops">' + encuesta.opciones.map((o,i) => {
          const v = conteo[i] || 0, pct = total ? Math.round(v * 100 / total) : 0;
          return '<div class="enc-res' + (String(i) === mio ? ' tuya' : '') + '">' +
                 '<div class="barra" style="width:' + pct + '%"></div>' +
                 '<div class="fila"><span>' + esc(o) + (String(i) === mio ? ' ✓' : '') + '</span>' +
                 '<span class="pct">' + pct + '%</span></div></div>';
        }).join('') +
        '</div><p class="enc-pie">' + total + (total === 1 ? ' respuesta' : ' respuestas') + ' · gracias por participar</p>';

    caja.innerHTML = '<div class="encuesta"><div class="cab">La pregunta de Puentes</div>' +
                     '<h3>' + esc(encuesta.pregunta) + '</h3>' + cuerpo + '</div>';

    caja.querySelectorAll('.enc-op').forEach(b =>
      b.addEventListener('click', () => votar(parseInt(b.dataset.i, 10))));
  }

  async function votar(opcion){
    caja.querySelectorAll('.enc-op').forEach(b => b.disabled = true);
    const { error } = await db.from('encuesta_votos')
      .insert({ encuesta_id: encuesta.id, opcion: opcion, device_id: DEVICE_ID });
    if(error && error.code !== '23505'){
      caja.querySelectorAll('.enc-op').forEach(b => b.disabled = false);
      alert('No se pudo registrar tu respuesta. Inténtalo de nuevo.');
      return;
    }
    localStorage.setItem('voto_' + encuesta.id, String(opcion));
    await pintar();
  }

  cargar();
})();
